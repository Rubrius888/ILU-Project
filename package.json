{
  "name": "ilu-project-portable",
  "version": "1.0.0",
  "private": true,
  "main": "electron-main.js",
  "scripts": {
    "start:electron": "electron .",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ru.ilu.project",
    "productName": "ILU-Project",
    "asar": true,
    "files": [
      "electron-main.js", "matrix.html", "style.css", "*.js", "*.png", "*.ico"
    ],
    "win": { "target": [{ "target": "portable", "arch": ["x64"] }] },
    "portable": { "artifactName": "ILU-Project-Portable.exe" }
  }
}
